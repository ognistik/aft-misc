						<key>Text</key>
						<string>#!/bin/bash
set -euo pipefail

# Opens the latest Superwhisper recording's audio file in Superwhisper, then
# returns focus to the app that was active before the macro ran.

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

recordings_dir="${SUPERWHISPER_RECORDINGS_DIR:-$HOME/Documents/superwhisper/recordings}"
superwhisper_bin="${SUPERWHISPER_BIN:-}"

if [[ -z "$superwhisper_bin" ]]; then
  if [[ -x "$HOME/.local/bin/superwhisper" ]]; then
    superwhisper_bin="$HOME/.local/bin/superwhisper"
  else
    superwhisper_bin="$(command -v superwhisper || true)"
  fi
fi

if [[ -z "$superwhisper_bin" || ! -x "$superwhisper_bin" ]]; then
  echo "Could not find the superwhisper CLI. Expected it at ~/.local/bin/superwhisper or somewhere on PATH."
  exit 1
fi

# Get the current app's bundle ID so Keyboard Maestro can return focus after
# opening the audio in Superwhisper.
current_app_bundle_id=$(
  osascript -e 'tell application "System Events" to get bundle identifier of first process whose frontmost is true'
)

# Optional: set SUPERWHISPER_RECORDING_ID in Keyboard Maestro to reprocess a
# specific recording. If omitted, the CLI returns the latest recording.
recording_id="${SUPERWHISPER_RECORDING_ID:-}"

if [[ -n "$recording_id" ]]; then
  recording_json="$("$superwhisper_bin" read "$recording_id" --json)"
else
  recording_json="$("$superwhisper_bin" read --json)"
fi

json_field() {
  printf '%s' "$recording_json" | plutil -extract "$1" raw -o - - 2&gt;/dev/null || true
}

folder_name="$(json_field folderName)"
recording_datetime="$(json_field datetime)"
recording_short_id="$(json_field id | cut -c 1-8)"

if [[ -z "$folder_name" ]]; then
  echo "The superwhisper CLI did not return a folderName for the selected recording."
  exit 1
fi

output_file="$recordings_dir/$folder_name/output.wav"

if [[ ! -f "$output_file" ]]; then
  echo "Could not find output.wav for recording ${recording_short_id:-unknown}."
  echo "Expected: $output_file"
  exit 1
fi

echo "Opening Superwhisper recording ${recording_short_id:-unknown} from ${recording_datetime:-unknown date}"
echo "$output_file"

if [[ "${DRY_RUN:-0}" == "1" ]]; then
  exit 0
fi

open -g -a "superwhisper" "$output_file"
osascript -e "tell application id \"$current_app_bundle_id\" to activate"
</string>
						<key>TimeOutAbortsMacro</key>
